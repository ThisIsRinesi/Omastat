# Maintainer: rinesi
pkgname=omastat
pkgver=0.1.2
pkgrel=1
pkgdesc="Local app focus tracking utility for Hyprland and Omarchy"
arch=("x86_64")
url="https://github.com/ThisIsRinesi/Omastat"
license=("MIT")
depends=("gcc-libs" "glibc" "systemd" "hyprland")
makedepends=("cargo")
source=("$pkgname-$pkgver.tar.gz")
sha256sums=("SKIP")

build() {
  cd "$pkgname-$pkgver"
  cargo build --release --locked -p omastat
}

check() {
  cd "$pkgname-$pkgver"
  cargo test --locked
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "target/release/omastat" "$pkgdir/usr/bin/omastat"
  install -Dm755 "target/release/omastatd" "$pkgdir/usr/bin/omastatd"
  install -Dm644 "packaging/systemd/omastat.service" "$pkgdir/usr/lib/systemd/user/omastat.service"
  install -Dm644 "README.md" "$pkgdir/usr/share/doc/omastat/README.md"
  install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/omastat/LICENSE"
  install -Dm755 "packaging/browser-extension/install.sh" "$pkgdir/usr/share/omastat/browser-extension/install.sh"
  install -Dm644 "packaging/browser-extension/domain-tracker/manifest.json" "$pkgdir/usr/share/omastat/browser-extension/domain-tracker/manifest.json"
  install -Dm644 "packaging/browser-extension/domain-tracker/background.js" "$pkgdir/usr/share/omastat/browser-extension/domain-tracker/background.js"
  install -Dm644 "packaging/omarchy/omastat/manifest.json" "$pkgdir/usr/share/omastat/omarchy/omastat/manifest.json"
  install -Dm644 "packaging/omarchy/omastat/BarWidget.qml" "$pkgdir/usr/share/omastat/omarchy/omastat/BarWidget.qml"
  install -Dm644 "packaging/omarchy/omastat/Model.js" "$pkgdir/usr/share/omastat/omarchy/omastat/Model.js"
  install -Dm644 "packaging/omarchy/omastat/Panel.qml" "$pkgdir/usr/share/omastat/omarchy/omastat/Panel.qml"
}
