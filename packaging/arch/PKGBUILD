# Maintainer: rinesi
pkgname=omastat
pkgver=0.1.0
pkgrel=1
pkgdesc="Local focused/open application usage utility for Hyprland and Omarchy"
arch=("x86_64")
url="https://github.com/rinesi/omastat"
license=("MIT")
depends=("gcc-libs" "glibc" "systemd" "hyprland")
makedepends=("cargo")
source=("$pkgname-$pkgver.tar.gz")
sha256sums=("SKIP")

build() {
  cd "$pkgname-$pkgver"
  cargo build --release --locked -p omastat
}

check() {
  cd "$pkgname-$pkgver"
  cargo test --locked
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "target/release/omastat" "$pkgdir/usr/bin/omastat"
  install -Dm644 "packaging/systemd/omastat.service" "$pkgdir/usr/lib/systemd/user/omastat.service"
  install -Dm644 "README.md" "$pkgdir/usr/share/doc/omastat/README.md"
  install -Dm644 "packaging/omarchy/omastat/manifest.json" "$pkgdir/usr/share/omastat/omarchy/omastat/manifest.json"
  install -Dm644 "packaging/omarchy/omastat/BarWidget.qml" "$pkgdir/usr/share/omastat/omarchy/omastat/BarWidget.qml"
}
