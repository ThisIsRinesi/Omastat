# Maintainer: rinesi
pkgname=nagori
pkgver=0.2.0
pkgrel=1
pkgdesc="Local app focus tracking utility for Hyprland and Omarchy"
arch=("x86_64")
url="https://github.com/ThisIsRinesi/Nagori"
license=("MIT")
depends=("gcc-libs" "glibc" "systemd" "hyprland" "python")
makedepends=("cargo")
source=("$pkgname-$pkgver.tar.gz")
sha256sums=("SKIP")

build() {
  cd "$pkgname-$pkgver"
  cargo build --release --locked -p nagori
}

check() {
  cd "$pkgname-$pkgver"
  cargo test --locked
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "target/release/nagori" "$pkgdir/usr/bin/nagori"
  install -Dm755 "target/release/nagorid" "$pkgdir/usr/bin/nagorid"
  install -Dm644 "packaging/systemd/nagori.service" "$pkgdir/usr/lib/systemd/user/nagori.service"
  sed -i 's|ExecStart=%h/.cargo/bin/nagorid|ExecStart=/usr/bin/nagorid|' "$pkgdir/usr/lib/systemd/user/nagori.service"
  install -Dm644 "packaging/owned-files.py" "$pkgdir/usr/share/nagori/owned-files.py"
  install -Dm755 "packaging/browser-extension/uninstall.sh" "$pkgdir/usr/share/nagori/browser-extension/uninstall.sh"
  install -Dm644 "README.md" "$pkgdir/usr/share/doc/nagori/README.md"
  install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/nagori/LICENSE"
  install -Dm755 "packaging/browser-extension/install.sh" "$pkgdir/usr/share/nagori/browser-extension/install.sh"
  install -Dm644 "packaging/browser-extension/signed/nagori-domain-tracker-firefox.xpi" "$pkgdir/usr/share/nagori/browser-extension/signed/nagori-domain-tracker-firefox.xpi"
  install -Dm644 "packaging/browser-extension/domain-tracker/manifest.json" "$pkgdir/usr/share/nagori/browser-extension/domain-tracker/manifest.json"
  install -Dm644 "packaging/browser-extension/domain-tracker/background.js" "$pkgdir/usr/share/nagori/browser-extension/domain-tracker/background.js"
  install -Dm644 "packaging/omarchy/nagori/manifest.json" "$pkgdir/usr/share/nagori/omarchy/nagori/manifest.json"
  install -Dm644 "packaging/omarchy/nagori/Model.js" "$pkgdir/usr/share/nagori/omarchy/nagori/Model.js"
  install -m644 packaging/omarchy/nagori/*.qml "$pkgdir/usr/share/nagori/omarchy/nagori/"
}
