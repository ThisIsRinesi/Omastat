{
  "schemaVersion": 1,
  "id": "local.omastat",
  "name": "Omastat",
  "version": "0.1.0",
  "author": "rinesi",
  "license": "MIT",
  "description": "Native Omarchy Quattro bar widget and popup for local Omastat usage data.",
  "kinds": ["bar-widget"],
  "activation": "on-demand",
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Omastat",
    "description": "Shows today's focused total, grouped app breakdown, and 7-day usage patterns.",
    "category": "Utilities",
    "aliases": ["omastat", "usage", "time"],
    "allowMultiple": false,
    "defaults": {
      "refreshIntervalSec": 60,
      "command": "omastat summary",
      "iconOnly": false,
      "terminalCommand": "xdg-terminal-exec --hold bash -lc 'PATH=\"$HOME/.cargo/bin:$HOME/.local/bin:$PATH\"; omastat tui'"
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 15,
        "max": 3600,
        "step": 15,
        "defaultValue": 60
      },
      {
        "key": "command",
        "type": "string",
        "label": "Report command",
        "defaultValue": "omastat summary"
      },
      {
        "key": "iconOnly",
        "type": "boolean",
        "label": "Icon-only mode",
        "defaultValue": false
      },
      {
        "key": "terminalCommand",
        "type": "string",
        "label": "Terminal command",
        "defaultValue": "xdg-terminal-exec --hold bash -lc 'PATH=\"$HOME/.cargo/bin:$HOME/.local/bin:$PATH\"; omastat tui'"
      }
    ]
  }
}
