{
  "schemaVersion": 1,
  "id": "local.nagori",
  "name": "Nagori",
  "version": "0.2.0",
  "author": "rinesi",
  "license": "MIT",
  "repository": "https://github.com/ThisIsRinesi/Nagori",
  "description": "Local app focus tracking for the Omarchy Quattro bar.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Nagori",
    "description": "Shows focused time, app mix, heatmaps, and insights in a QML analytics panel.",
    "category": "Utilities",
    "aliases": [
      "nagori",
      "usage",
      "time",
      "focus"
    ],
    "defaultSection": "right",
    "allowMultiple": false,
    "defaults": {
      "refreshIntervalSec": 60,
      "iconOnly": false,
      "dynamicIslandStyle": false,
      "panelWidth": 1160,
      "richGraphs": true,
      "reduceMotion": false,
      "insightTone": 0
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 15,
        "max": 3600,
        "step": 15,
        "defaultValue": 60
      },
      {
        "key": "iconOnly",
        "type": "boolean",
        "label": "Icon-only mode",
        "defaultValue": false
      },
      {
        "key": "dynamicIslandStyle",
        "type": "boolean",
        "label": "Dynamic Island appearance",
        "defaultValue": false
      },
      {
        "key": "richGraphs",
        "type": "boolean",
        "label": "Rich graphs",
        "defaultValue": true
      },
      {
        "key": "reduceMotion",
        "type": "boolean",
        "label": "Reduce motion",
        "defaultValue": false
      },
      {
        "key": "panelWidth",
        "type": "integer",
        "label": "Dashboard width",
        "min": 380,
        "max": 2000,
        "step": 20,
        "defaultValue": 1160
      },
      {
        "key": "insightTone",
        "type": "integer",
        "label": "Insight tone (0 Warm, 1 Concise, 2 Playful)",
        "min": 0,
        "max": 2,
        "step": 1,
        "defaultValue": 0
      }
    ]
  }
}
