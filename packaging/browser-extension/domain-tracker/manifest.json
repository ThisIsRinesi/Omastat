{
  "manifest_version": 2,
  "name": "Nagori Domain Tracker",
  "version": "0.4.0",
  "description": "Reports focused and audible tab domains to local Nagori.",
  "permissions": [
    "tabs",
    "nativeMessaging"
  ],
  "background": {
    "scripts": [
      "config.js",
      "background.js"
    ],
    "persistent": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "nagori-domain-tracker@thisisrinesi.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity"
        ]
      }
    }
  }
}
