[Unit]
Description=Hours Played app usage tracker
Documentation=https://wiki.hypr.land/IPC/
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=PATH=%h/.cargo/bin:%h/.local/bin:/usr/local/bin:/usr/bin
ExecStart=/usr/bin/env hours-played daemon
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=graphical-session.target
