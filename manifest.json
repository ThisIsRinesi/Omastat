{
  "schemaVersion": 1,
  "id": "local.omastat",
  "name": "Omastat",
  "version": "0.1.3",
  "author": "rinesi",
  "license": "MIT",
  "repository": "https://github.com/ThisIsRinesi/Omastat",
  "description": "Local app focus tracking for the Omarchy Quattro bar.",
  "kinds": ["bar-widget"],
  "entryPoints": {
    "barWidget": "packaging/omarchy/omastat/BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Omastat",
    "description": "Shows focused time, app mix, heatmaps, and insights in a QML analytics panel.",
    "category": "Utilities",
    "aliases": ["omastat", "usage", "time", "focus"],
    "defaultSection": "right",
    "allowMultiple": false,
    "defaults": {
      "refreshIntervalSec": 60,
      "iconOnly": false
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 15,
        "max": 3600,
        "step": 15,
        "defaultValue": 60
      },
      {
        "key": "iconOnly",
        "type": "boolean",
        "label": "Icon-only mode",
        "defaultValue": false
      }
    ]
  }
}
